# =============================================================================
# Bayesian Pet Localization — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored and will NOT be committed to version control.
# =============================================================================

# ---- InfluxDB ----
INFLUXDB_ADMIN_USER=CHANGE_ME
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME
INFLUXDB_TOKEN=CHANGE_ME
INFLUXDB_ORG=pet-localization
INFLUXDB_BUCKET=rssi_raw

# ---- PostgreSQL ----
POSTGRES_USER=localization
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pet_tracking

# ---- MQTT ----
MQTT_HOST=mosquitto
MQTT_PORT=1883

# ---- Beacon ----
BEACON_ID=iBeacon:CHANGE_ME
